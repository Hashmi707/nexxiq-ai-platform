# ==============================================================================
# Agentic Social & Client Finder — Environment Configuration Template
# Copy this file to .env and customize with your live credentials.
# NEVER commit your actual .env file with production secrets to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & BRANDING CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production
APP_NAME="Agentic Social & Client Finder"
APP_DOMAIN="syed-akber-hashmi-v2.vercel.app"
APP_URL="https://syed-akber-hashmi-v2.vercel.app/"

# ------------------------------------------------------------------------------
# 2. FOUNDER & CANDIDATE IDENTITY (Syed Akbar Hashmi)
# ------------------------------------------------------------------------------
CANDIDATE_NAME="Syed Akbar Hashmi"
CANDIDATE_TITLE="AI Native Full Stack Developer"
CANDIDATE_EMAIL="syedakbarhashmi519@gmail.com"
CANDIDATE_PHONE="+91 6305700963"
CANDIDATE_PORTFOLIO="https://syed-akber-hashmi-v2.vercel.app/"
CANDIDATE_LINKEDIN="https://www.linkedin.com/in/syed-akbar-hashmi"
CANDIDATE_GITHUB="https://github.com/Hashmi707"
COMPANY_NAME="Agentic Social AI"
FOUNDER_EXPERIENCE_YEARS="4+"
FOUNDER_SKILLS="React, Next.js, Flutter, Python, FastAPI, Node.js, AI Automation, Autonomous Agents, PostgreSQL, Docker"

# ------------------------------------------------------------------------------
# 3. SECURE SMTP / OUTREACH CONFIGURATION
# ------------------------------------------------------------------------------
# Standard SMTP credentials (e.g. Hostinger, cPanel, Gmail App Password, AWS SES)
SMTP_HOST=mail.wavcabs.com.au
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@wavcabs.com.au
SMTP_PASS=your_secure_smtp_password_here
EMAIL_FROM="Syed Akbar Hashmi <info@wavcabs.com.au>"
EMAIL_REPLY_TO="syedakbarhashmi519@gmail.com"
EMAIL_RATE_LIMIT_PER_MINUTE=10

# ------------------------------------------------------------------------------
# 4. AI & LLM PROVIDER CREDENTIALS
# ------------------------------------------------------------------------------
# Antigravity CLI / Gemini API
AI_PROVIDER=antigravity
AI_MODEL=Gemini 3.8 Flash
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 5. MULTI-PLATFORM JOB APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
JOB_AUTOMATION_ENABLED=true
LINKEDIN_ENABLED=true
INDEED_ENABLED=true
CUSTOM_BOARDS_ENABLED=true

# Remote & Targeting Constraints
JOB_REMOTE_ONLY=true
JOB_MIN_MATCH_SCORE=75
ATS_MIN_ACCEPTABLE_SCORE=80

# ------------------------------------------------------------------------------
# 6. BROWSER AUTOMATION & CDP ISOLATION (Optional for Headless Agents)
# ------------------------------------------------------------------------------
THREADS_CDP_URL=http://127.0.0.1:9222
JOB_BROWSER_CDP_URL=http://127.0.0.1:9223
BROWSER_TYPE=auto
DESKTOP_SPLIT_PERCENT=50

# ------------------------------------------------------------------------------
# 7. SAFETY & RATE LIMITING
# ------------------------------------------------------------------------------
DRY_RUN=false
POSTING_ENABLED=true
MAX_NEW_POST_REPLIES_PER_HOUR=5
MAX_TOTAL_REPLIES_PER_HOUR=15
MAX_DM_REPLIES_PER_HOUR=10
MIN_ACTION_DELAY_MS=15000
MAX_ACTION_DELAY_MS=45000
