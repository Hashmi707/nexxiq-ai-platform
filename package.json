{
  "name": "nexxiq-ai-platform",
  "version": "2.1.0",
  "description": "NexxIQ AI Platform (nexxiqai.com) — End-to-end autonomous AI system for lead generation, multi-platform job applications (LinkedIn, Indeed, Custom ATS), AI resume enhancement, and secure SMTP outreach.",
  "main": "src/server.js",
  "bin": {
    "nexxiq-ai": "./src/server.js",
    "meta-automation": "./threads-agent.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "web": "node src/server.js",
    "server": "node src/server.js",
    "dev": "node src/server.js",
    "desktop": "node scripts/desktop-runner.js",
    "desktop:layout": "node scripts/layout-cdp-windows.js",
    "test": "node tests/suite.js && node tests/cross-platform-audit.js && node tests/job-engine-audit.js && node tests/desktop-runner.test.js && node tests/autopilot-modes.test.js && node tests/nexxiq-platform.test.js && node tests/smoke-test.js",
    "test:nexxiq": "node tests/nexxiq-platform.test.js",
    "workflow:lead": "node -e \"require('./src/orchestrator/unified-workflow').runLeadOutreachPipeline({leadId: 'lead_nexx_101'}).then(r => console.log(r))\"",
    "workflow:job": "node -e \"require('./src/orchestrator/unified-workflow').runJobApplicationPipeline({platform: 'LinkedIn'}).then(r => console.log(r))\"",
    "deals": "node scripts/show-deals.js",
    "pitch": "node scripts/pitch-qualified-leads.js",
    "dm": "node scripts/send-direct-pitches.js",
    "email": "node scripts/send-email-pitch.js",
    "carousel": "node scripts/generate-linkedin-carousel.js",
    "linkedin:apply": "node scripts/linkedin-easy-apply-bot.js",
    "linkedin:run": "node threads-agent.js run linkedin",
    "jobs:setup": "node scripts/setup-job-engine.js",
    "jobs:scan": "node job-agent.js scan",
    "jobs:run": "node job-agent.js run",
    "jobs:status": "node job-agent.js status"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/syedakbarhashmi/nexxiq-ai-platform.git"
  },
  "keywords": [
    "nexxiq-ai",
    "nexxiqai",
    "ai-agent",
    "autonomous-agents",
    "lead-generation",
    "job-automation",
    "ats-optimizer",
    "resume-enhancer",
    "smtp-outreach",
    "linkedin-easy-apply",
    "indeed-jobs",
    "workflow-automation"
  ],
  "author": "Syed Akbar Hashmi <syedakbarhashmi519@gmail.com> (https://syed-akber-hashmi-v2.vercel.app/)",
  "license": "MIT",
  "homepage": "https://nexxiqai.com",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "nodemailer": "^10.2.0",
    "pdf-parse": "^1.1.1",
    "puppeteer-core": "^25.11.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
